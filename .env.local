# PlaceIT Backend Service URLs
# These are the default values used if not set.
# Uncomment and change if your services run on different ports.

# Canonical backend URL (checked first by lib/gateway.ts and next.config.mjs)
BACKEND_URL=http://localhost:8080

# API Gateway (legacy alias — kept for backwards compatibility)
BACKEND_GATEWAY_URL=http://localhost:8080

# Direct service URLs (used as fallback when gateway is down or returns errors)
AUTH_SERVICE_URL=http://localhost:8081
STUDENT_SERVICE_URL=http://localhost:8082
COMPANY_SERVICE_URL=http://localhost:8083
PLACEMENT_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
