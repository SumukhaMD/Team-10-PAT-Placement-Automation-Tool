# Copy this file to .env.local for local development
# Copy this file to .env.production for production deployment

# API Gateway URL (used by Next.js server-side routes)
BACKEND_URL=http://localhost:8080

# Alias (kept for backward compatibility)
BACKEND_GATEWAY_URL=http://localhost:8080

# Direct service URLs (fallback when gateway is unavailable)
AUTH_SERVICE_URL=http://localhost:8081
STUDENT_SERVICE_URL=http://localhost:8082
COMPANY_SERVICE_URL=http://localhost:8083
PLACEMENT_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
